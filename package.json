{
  "name": "@wkovacs64/oxfmt-config",
  "version": "1.0.0",
  "private": false,
  "description": "@wKovacs64 Oxfmt config",
  "keywords": [
    "oxfmt",
    "oxfmtconfig"
  ],
  "homepage": "https://github.com/wKovacs64/oxfmt-config#readme",
  "bugs": {
    "url": "https://github.com/wKovacs64/oxfmt-config/issues"
  },
  "license": "",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wKovacs64/oxfmt-config.git"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@wkovacs64/eslint-config": "7.14.1",
    "eslint": "9.39.4",
    "oxfmt": "0.49.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.45.0 <1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.1.3"
}
